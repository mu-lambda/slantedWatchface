load("@rules_python//python:defs.bzl", "py_test")
load("//tools/android:wff.bzl", "res_files", "wff_apk", "wff_install")

PACKAGE = "de.mulambda.slantedWatchface"

# Resource name -> font file. Must match FONTS in generator/generate.py.
FONTS = {
    res: "fonts/%s.ttf" % res
    for res in [
        "bebas_kai",
        "fenwick_woodtype",
        "grafik_text",
        "limelight",
        "ordinary",
        "sweet_hipster",
    ]
}

# Defaults of the user settings can be overridden for screenshots, e.g.
#   bazel run //watchface:install --define=WFF_DEFAULTS=font=bebas_kai,is24h=FALSE
genrule(
    name = "generate_watchface",
    srcs = FONTS.values(),
    outs = [
        "watchface.xml",
        "generated_strings.xml",
    ] + ["font_icon_%s.xml" % res for res in FONTS],
    cmd = " ".join(
        ["$(location //watchface/generator:generate)"] +
        ["--font %s=$(location %s)" % (res, src) for res, src in FONTS.items()] +
        [
            "--watchface_out $(location watchface.xml)",
            "--strings_out $(location generated_strings.xml)",
        ] + ["--icon_out %s=$(location font_icon_%s.xml)" % (res, res) for res in FONTS] + [
            "--defaults '$(WFF_DEFAULTS)'",
        ],
    ),
    tools = ["//watchface/generator:generate"],
)

wff_apk(
    name = "slanted",
    manifest = "AndroidManifest.xml",
    resources = res_files(glob(["res/**"])) | {
        ":watchface.xml": "raw/watchface.xml",
        ":generated_strings.xml": "values/generated_strings.xml",
    } | {src: "font/%s.ttf" % res for res, src in FONTS.items()} | {
        ":font_icon_%s.xml" % res: "drawable/font_icon_%s.xml" % res
        for res in FONTS
    },
    # Must stay above the version codes of the original (pre-WFF) releases on Play.
    version_code = 1000,
    version_name = "2.0-dev",
)

wff_install(
    name = "install",
    apk = ":slanted",
    package = PACKAGE,
)

py_test(
    name = "watchface_schema_test",
    srcs = ["validate_schema.py"],
    args = [
        "$(rootpath @wff_spec//:1/watchface.xsd)",
        "$(rootpath :watchface.xml)",
    ],
    data = [
        ":watchface.xml",
        "@wff_spec//:1/watchface.xsd",
        "@wff_spec//:v1",
    ],
    main = "validate_schema.py",
    deps = ["@slanted_pypi//xmlschema"],
)
