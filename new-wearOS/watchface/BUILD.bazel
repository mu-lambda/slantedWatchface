load("@rules_python//python:defs.bzl", "py_test")
load("//tools/android:wff.bzl", "res_files", "wff_apk", "wff_install")
load("//watchface/generator:defs.bzl", "watchface_resources")

PACKAGE = "de.mulambda.slantedWatchface"

watchface_resources(
    name = "watchface",
    # Each font's file name is its resource name. Must match FONTS in generator/generate.py.
    fonts = glob(["fonts/*.ttf"]),
)

filegroup(
    name = "watchface_xml",
    srcs = [":watchface"],
    output_group = "watchface_xml",
)

wff_apk(
    name = "slanted",
    manifest = "AndroidManifest.xml",
    resource_sets = [":watchface"],
    resources = res_files(glob(["res/**"])),
    # Must stay above the version codes of the original (pre-WFF) releases on Play.
    version_code = 1000,
    version_name = "2.0-dev",
)

wff_install(
    name = "install",
    apk = ":slanted",
    package = PACKAGE,
)

py_test(
    name = "watchface_schema_test",
    srcs = ["validate_schema.py"],
    args = [
        "$(rootpath @wff_spec//:1/watchface.xsd)",
        "$(rootpath :watchface_xml)",
    ],
    data = [
        ":watchface_xml",
        "@wff_spec//:1/watchface.xsd",
        "@wff_spec//:v1",
    ],
    main = "validate_schema.py",
    deps = ["@slanted_pypi//xmlschema"],
)
