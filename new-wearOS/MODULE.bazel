"""Bazel build for the Watch Face Format (WFF) version of Slanted!."""

module(name = "slanted_watchface")

bazel_dep(name = "rules_python", version = "2.4.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "slanted_pypi",
    python_version = "3.12",
    requirements_lock = "//watchface/generator:requirements_lock.txt",
)
use_repo(pip, "slanted_pypi")

# Pinned Android build-tools, plus android.jar/adb/debug keystore from the local SDK.
android_sdk = use_extension("//tools/android:sdk.bzl", "android_sdk")
use_repo(android_sdk, "android_build_tools", "local_android_sdk")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Official Watch Face Format XSD schemas, used to validate the generated watchface.xml.
http_archive(
    name = "wff_spec",
    build_file_content = """
exports_files(glob(["**/*.xsd"]))

[filegroup(
    name = "v%d" % v,
    srcs = glob(["%d/**/*.xsd" % v]),
    visibility = ["//visibility:public"],
) for v in [1, 2, 3, 4]]
""",
    sha256 = "95f81dce973ab2140660b59b8709ab2a41217e26eed519ffff5a6f64ddc20eef",
    strip_prefix = "watchface-d1cdafa953c95d5554fc54df4bc3948befbefc4d/third_party/wff/specification/documents",
    urls = ["https://github.com/google/watchface/archive/d1cdafa953c95d5554fc54df4bc3948befbefc4d.tar.gz"],
)
